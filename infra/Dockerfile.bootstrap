FROM python:3.12-slim

RUN apt-get update && apt-get install -y --no-install-recommends curl && rm -rf /var/lib/apt/lists/*

WORKDIR /workspace
COPY infra/requirements.txt /tmp/requirements.txt
RUN pip install --no-cache-dir --quiet -r /tmp/requirements.txt

# The whole repo is mounted at runtime (see docker-compose.yml) so bootstrap.py
# can zip up services/lambdas/* without duplicating build context here.
CMD ["python", "infra/bootstrap.py"]
